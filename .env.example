# TEMPLATE ONLY — copy to .env and populate locally.
# Never commit .env or real credentials.

# ServiceNow credentials (used by the supplied script)
SERVICENOW_USER=replace_with_servicenow_service_account
SERVICENOW_PASSWORD=replace_with_secret

# CUCM AXL credentials and endpoint (AXL_WSDL should point to a local WSDL file)
CUCM_ADDRESS=https://cucm-publisher.example.com:8443/axl/
CUCM_USERNAME=replace_with_axl_service_account
CUCM_PASSWORD=replace_with_secret
CUCM_VERSION=15.0
AXL_WSDL=/absolute/path/to/AXLAPI.wsdl

# Active Directory LDAP settings (required at script startup)
AD_SERVER=dc01.example.com
AD_USER=EXAMPLE\\svc_uc_automation
AD_PASSWORD=replace_with_secret
AD_SEARCH_BASE=DC=example,DC=com

# Unity Connection credentials
CUC_USERNAME=replace_with_cuc_service_account
CUC_PASSWORD=replace_with_secret

# ServiceNow assignment group sys_id for the Unified Communications team
UC_ASSIGNMENT_GROUP_SYS_ID=replace_with_real_group_sys_id

# Optional AXL SOAP request/response debug output. Keep disabled unless troubleshooting.
AXL_DEBUG=0

# NOTE: The supplied script currently hardcodes SERVICENOW_URL, CUC_ADDRESS,
# CUC_TEMPLATE, catalog identifiers, and several CUCM device/line values.
# Adding variables for those settings here does not override the hardcoded values.
